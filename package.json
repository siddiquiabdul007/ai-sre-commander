{
  "name": "ai-sre-commander",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Grade AI-Powered Incident Detection, Investigation, Remediation & Reliability Control Plane",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "agents/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --env-file=.env --test tests/unit/*.test.js",
    "test:integration": "node tests/integration/auth-jwks.test.js && node tests/integration/prometheus-live.test.js && node tests/integration/k8s-execution.test.js",
    "test:concurrency": "node --env-file=.env --test tests/integration/concurrency-quorum.test.js",
    "test:chaos": "node --env-file=.env --test tests/chaos/fault-injection.test.js",
    "test:security": "node --env-file=.env --test tests/security/prompt-injection.test.js",
    "test:persistence": "node --env-file=.env --test tests/integration/persistence.test.js",
    "test:e2e": "node tests/e2e/golden-incident-live.test.js",
    "drill:live": "node --env-file=.env scripts/run-live-azure-drill.js",
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "lint": "./scripts/lint.sh"
  },
  "keywords": [
    "sre",
    "ai",
    "kubernetes",
    "incident-management",
    "dora",
    "nis2",
    "eu-ai-act"
  ],
  "author": "Abdul Ahad Siddiqui <abdulahadsiddiqui888@gmail.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.8.2"
  }
}
