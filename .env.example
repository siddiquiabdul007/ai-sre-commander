# AI SRE Commander — Environment Configuration Template
# Copy this file to .env and fill in your live credentials.
# NOTE: .env is ignored by Git and must never be committed.

# 1. LLM Gateway (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_REASONING_MODEL=gemini-3.5-flash-lite

# 2. Kubernetes (Azure AKS Sandbox Cluster)
K8S_NAMESPACE=sre-demo
CLUSTER_NAME=aks-aisre-prod
AZURE_RESOURCE_GROUP=rg-aisre-prod-centralindia
K8S_EXECUTOR_TOKEN=your_k8s_sre_executor_service_account_token
K8S_READER_TOKEN=your_k8s_sre_reader_service_account_token

# 3. Database (Azure Database for PostgreSQL Flexible Server)
DATABASE_URL=postgresql://sreadmin:<password>@<postgres_fqdn>:5432/sre_commander?sslmode=require

# 4. Telemetry (In-Cluster Prometheus)
PROMETHEUS_URL=http://localhost:9090

# 5. Auth / Identity (Microsoft Entra ID / OIDC RS256 JWKS)
ENTRA_TENANT_ID=your_entra_tenant_id_here
ENTRA_CLIENT_ID=your_entra_client_id_here
ENTRA_JWKS_URI=https://login.microsoftonline.com/your_entra_tenant_id_here/discovery/v2.0/keys
ENTRA_ISSUER=https://sts.windows.net/your_entra_tenant_id_here/

# 6. Compliance / Audit Ledger WORM Storage (Azure Blob Storage)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;EndpointSuffix=core.windows.net;AccountName=<account>;AccountKey=<key>;BlobEndpoint=https://<account>.blob.core.windows.net/;
AUDIT_CONTAINER_NAME=audit-evidence

# 7. Webhook Security
WEBHOOK_SECRET=your_hmac_sha256_webhook_secret_here
