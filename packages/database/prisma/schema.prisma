datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Incident {
  id                       String   @id @default(uuid())
  tenantId                 String
  title                    String
  severity                 String   // SEV-1, SEV-2, SEV-3, SEV-4
  service                  String
  environment              String
  cluster                  String
  namespace                String
  state                    String   // DETECTED, CORRELATED, PROPOSED, AWAITING_APPROVAL, APPROVED, EXECUTING, VERIFYING, NOT_RECOVERED, UNKNOWN, RESOLVED, POSTMORTEM, etc.
  version                  Int      @default(1) // Concurrency token for optimistic locking (FR-P0-002)
  mttdSeconds              Int?
  mttrSeconds              Int?
  errorBudgetImpactPercent Float    @default(0)
  resolvedAt               DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  timeline             TimelineEntry[]
  evidence             EvidenceRecord[]
  proposals            RemediationRecord[]
  remediationProposals RemediationProposal[]
  executions           Execution[]
  verificationRuns     VerificationRun[]

  @@index([tenantId, state, createdAt])
  @@index([tenantId, service, environment])
  @@index([state])
}

model TimelineEntry {
  id          String   @id @default(uuid())
  incidentId  String
  tenantId    String   @default("tenant-eu-default")
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String
  data        Json?
  timestamp   DateTime @default(now())

  @@index([incidentId])
  @@index([tenantId])
}

model EvidenceRecord {
  id              String   @id @default(uuid())
  incidentId      String
  tenantId        String   @default("tenant-eu-default")
  incident        Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type            String
  source          String
  title           String
  summary         String
  confidence      Float
  isContradictory Boolean  @default(false)
  provenance      Json?
  data            Json?
  createdAt       DateTime @default(now())

  @@index([incidentId])
  @@index([tenantId])
}

model RemediationRecord {
  id             String   @id @default(uuid())
  incidentId     String
  incident       Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  action         String
  targetResource String
  parameters     Json?
  riskAssessment Json?
  status         String   // PENDING_APPROVAL, APPROVED, EXECUTING, SUCCESS, FAILED
  idempotencyKey String   @unique // PRD §18: Hard DB-level uniqueness constraint
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([incidentId])
  @@index([idempotencyKey])
}

model RemediationProposal {
  id                      String   @id @default(uuid())
  incidentId              String
  tenantId                String   @default("tenant-eu-default")
  incident                Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  action                  String
  targetResource          String
  parameters              Json?
  computedRisk            String   // Canonical deterministic risk (LOW, MEDIUM, HIGH, CRITICAL)
  modelRisk               String?  // Advisory risk proposed by AI
  proposalHash            String   // Canonical proposal snapshot hash
  snapshotHash            String?  // Complete infrastructure snapshot hash (R7)
  policyVersion           String?  @default("1.0.0")
  evidenceSetHash         String?  // Hash of evidence set at proposal time
  observedStateHash       String?  // Canonical hash of target K8s state when proposed
  observedResourceVersion String?  // Target K8s resourceVersion when proposed
  status                  String   // PROPOSED, PENDING_APPROVAL, APPROVED, REJECTED, EXECUTING, SUCCESS, FAILED, EXPIRED, STALE
  version                 Int      @default(1)
  idempotencyKey          String   @unique
  expiresAt               DateTime?
  approvedBy              String?
  approvedAt              DateTime?
  rejectionReason         String?
  expectedImpact          String?
  blastRadius             String?
  proposedBy              String?
  reason                  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  approvals  Approval[]
  executions Execution[]

  @@index([incidentId])
  @@index([idempotencyKey])
  @@index([tenantId])
}

model Approval {
  id                  String              @id @default(uuid())
  proposalId          String
  tenantId            String              @default("tenant-eu-default")
  proposal            RemediationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  approverSubject     String              // Unique approver identity
  approverName        String?
  approverEmail       String?
  role                String              // Role exercised for approval
  justificationHash   String              // SHA-256 hash of justification
  justification       String?
  proposalHash        String              // Snapshot hash bound to this approval
  snapshotHash        String?             // Immutable approval snapshot hash (R7)
  deploymentUid       String?             // Target deployment UID
  resourceVersion     String?             // Target resourceVersion at approval
  targetReplicaSetUid String?             // Target ReplicaSet UID
  targetTemplateHash  String?             // Target PodTemplateSpec hash
  expiresAt           DateTime?           // Immutable fixed proposal deadline (R8)
  approvedAt          DateTime            @default(now())

  @@unique([proposalId, approverSubject])
  @@index([proposalId])
  @@index([tenantId])
}

model Execution {
  id                String              @id @default(uuid())
  proposalId        String
  incidentId        String
  tenantId          String              @default("tenant-eu-default")
  proposal          RemediationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  incident          Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  idempotencyKey    String              @unique
  status            String              // PENDING, CLAIMED, EXECUTING, SUCCEEDED, FAILED, UNKNOWN, EXPIRED
  attempt           Int                 @default(1)
  claimedBy         String?             // Worker/agent id that holds the lease
  leaseUntil        DateTime?
  desiredStateHash  String?
  observedStateHash String?
  staleReason       String?             // Reason if marked STALE_TARGET / REEVALUATION_REQUIRED
  externalRequestId String?
  errorCode         String?
  errorDetails      Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  verificationRuns VerificationRun[]

  @@index([incidentId])
  @@index([proposalId])
  @@index([tenantId])
  @@index([idempotencyKey])
}

model VerificationRun {
  id             String     @id @default(uuid())
  incidentId     String
  executionId    String?
  tenantId       String     @default("tenant-eu-default")
  incident       Incident   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  execution      Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  status         String     // OK, UNKNOWN, NOT_RECOVERED, VERIFIED
  result         String?    // VERIFIED, NOT_RECOVERED, UNKNOWN
  probeStates    Json?      // Status of each individual probe (OK, UNAVAILABLE, INVALID)
  evidenceHashes Json?      // SHA256 hashes of telemetry evidence evaluated
  startTime      DateTime   @default(now())
  endTime        DateTime?
  completedAt    DateTime?
  evidenceJson   Json?
  summary        String
  createdAt      DateTime   @default(now())

  @@index([incidentId])
  @@index([tenantId])
}

model AuditRecord {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  tenant         String
  actor          String
  action         String
  targetResource String
  proposalHash   String?
  approvalIds    String?
  executionId    String?
  targetUid      String?
  stateHashes    String?
  payloadHash    String
  previousHash   String
  hash           String
  metadata       Json?

  @@index([tenant, timestamp])
}

model EvidenceArtifact {
  id           String   @id @default(uuid())
  claimId      String
  pathOrObject String
  sha256       String
  sourceCommit String
  createdAt    DateTime @default(now())

  @@index([claimId])
  @@index([sourceCommit])
}

